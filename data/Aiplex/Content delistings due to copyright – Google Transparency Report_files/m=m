_.dW,_.eW],styles:[".section-links[_ngcontent-%COMP%]{text-align:center}.section-links[_ngcontent-%COMP%]   a[_ngcontent-%COMP%]{margin:20px}"],ma:1});var Xbb=new Map([[0,nC("Y2018H1")],[1,nC("Y2018H2")],[2,nC("Y2019H1")],[3,nC("Y2019H2")],[4,nC("Y2020H1")],[5,nC("Y2020H2")],[6,nC("Y2021H1")],[7,nC("Y2021H2")],[8,nC("Y2022H1")],[9,nC("Y2022H2")],[10,nC("Y2023H1")]]),oC=[{Fa:0,type:0,text:"A music video showing a naked man coming out of the ocean was reported several times for illegal sexual content."},{Fa:0,type:0,text:"A speech by Angela Merkel about whether Islam belongs to Germany was reported for hate speech as well as terrorist content because Merkel according to the requestors would endanger the country and lead Germany into a catastrophe."},
{Fa:0,type:0,text:"A video by Jan B\u00f6hmermann, in which he makes a far right group subject of critical and satirical discussion, received several reports because of alleged hate speech, violence, spam, defamation and insults."},{Fa:0,type:0,text:"A comment that praises  \u201ccuddling at home\u201d was flagged for \u201charmful or dangerous acts\u201d."},{Fa:0,type:1,text:"A video showing a known German Islamic \u201chate preacher\u201d calling for \u201cdua\u201d and \u201ctawaf\u201d; \u201ctakbir\u201d hacklings can be heard from the community.  The video was reported under NetzDG for terrorist content several times . As the Da\u2019wa spectrum also allows another interpretation than pure propaganda, and propaganda couldn\u2019t be identified in the video, outside counsel identified it as legal."},
{Fa:0,type:1,text:"A video showing footage of weapons and fully blurred dead bodies out of a war zone, the acronym \u201cYPG\u201d is shown on the right corner. Outside counsel did not find any illegal signs, nor any call for propaganda."},{Fa:0,type:1,text:"A video playing the first few seconds of a Horst Wessels song that is prohibited in Germany along with speeches of AfD politicians in the German Parliament. Outside counsel identified this as a use of an illegal sign."},{Fa:0,type:2,text:"A video of a historic anti-semitic speech uploaded by a rabbi to expose and criticize the existence of such views would likely be allowed under our global policies. We may discern this context via the video description and other content uploaded to the creator\u2019s channel. However the same content uploaded to glorify or encourage such views would likely violate our policies thus be removed."},
{Fa:0,type:2,text:"A video of a terrorist attack may be informative news reporting if uploaded by a news outlet or citizen journalist, but that same video clip can be used for recruitment if uploaded by the terrorist organization itself in an effort to glorify or recruit. Informative news would likely be allowed under our global policies, whereas terrorist recruitment would likely violate our policies and thus be removed."},{Fa:0,type:3,text:"Videos that educate and inform patients who have undergone a mastectomy are common on YouTube. These videos often contain information on how the procedure works and techniques for caring for oneself after the operation. Some videos can show exposed breasts or graphic surgery images, but these videos are allowed because of the educational purpose."},
{Fa:0,type:3,text:"There are videos on YouTube documenting the former German NS-regime and the life of Hitler. This footage contains, for example, signs that are ordinarily illegal in Germany. However, these videos are not prohibited by law because of their documentary nature."},{Fa:0,type:3,text:"Although we prohibit content intended to shock or disgust, we make exceptions for scientific content that is primarily intended to educate viewers. Users may find it hard to watch a video of animal dissection, for example, but if the video includes commentary by a veterinary surgeon or expert, it will remain on the platform."},
{Fa:0,type:3,text:"A German art and activist collective creates subversive performance art with the aim to activate civil society to more courageous campaigns. Several times, the collective infiltrated with wrong identities events as an act of civil disobedience. Some of their videos call for illegal acts and disguise their real identity, so this type of content would typically violate YouTube\u2019s Global Community Guidelines, but in this artistic context the content is allowed to remain up."},
{Fa:0,type:4,text:"A company made a defamation claim against a video made by young adults who criticize and compare the company\u2019s venue with other competitors. Price, equipment and size of the venue are subject of discussion. The company claims these statements are untrue."},{Fa:0,type:4,text:"A managing director of a company made a defamation claim against several videos accusing him and the company of fraudulent activities. Main allegations are that the company would fake all their positive reviews online as well as own some dubious websites. The direction claims these statements are untrue."},
{Fa:0,type:4,text:"We received several claims for insults of third parties especially in gaming and music videos. Statements like \u201ccheeky\u201d \u201carrogant\u201d or \u201cintrusive\u201d were reported as illegal insults."},{Fa:1,type:0,text:"A video using parts of a report from a publicly funded media broadcaster criticizes the Islamic religion for being dangerous. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:1,type:0,text:"A video from a privately owned media broadcaster about bikini fashion was reported for allegedly containing illegal sexual content. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:1,type:0,text:"A video was reported that calls for a public protest against the political system in Germany. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:1,type:1,text:"A video that shows a public speech at an event of a political party was reported for inciting hate against people of color. We found that the video violates German law, and we blocked it for Germany."},{Fa:1,type:1,text:"A video that shows segments of Sponge Bob videos referring to World War II and showing Swastika symbols was flagged for Nazi propaganda. The video contains satire and criticism of fascism. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:1,type:1,text:"We received complaints about several videos with parts of a Nazi song that is prohibited in Germany. We found that the videos violate German law, and we blocked them for Germany."},{Fa:1,type:2,text:"A video with critical statements about immigration and Islam using the suicide of a Dutch politician who criticizes Islamic groups was reported for hate speech. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:1,type:2,text:"A video shows the evolution of several famous soccer team logos, including the logo of Bayern Munich from 1945, featuring a swastika. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:1,type:3,text:"A video with a Hitler speech recording was flagged for hate speech. The video was uploaded to a channel dedicated to documenting history; the video title and description frame the historical context. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:1,type:3,text:"News coverage about a prison riot showing violent scenes was flagged for violence, defamation and hate speech. The video documents a current newsworthy event. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:1,type:3,text:"A video with commentary from a former ISIS defector encouraging others not to join ISIS was reported for terrorist content. It shows an ISIS flag, which is a symbol of a banned organization. The video has documentary intent and lacks glorification and support for ISIS. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:1,type:4,text:"Various comments under make-up tutorial videos were reported for insulting girls and women. We found that the comments violated German law, and we blocked them for Germany."},
{Fa:1,type:4,text:"A video reported on a professional animal keeper, but the title called him an animal abuser. We found that the video violates German law, and we blocked it for Germany."},{Fa:1,type:4,text:"We received a defamation complaint regarding a video in which specific people are called child abusers and pedophiles. We found that the video violates German law, and we blocked it for Germany."},{Fa:1,type:4,text:"We received a defamation complaint from a company regarding a parody video of their original advertisement video, created with the intent to ridicule the company and its employees. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:2,type:4,text:"A comedy video showing different people answering search queries as if they were Google\u2019s search engine was reported for hate speech. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:4,text:"A video showing top ten gaming moments was reported for insult. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:4,text:"We received several hate speech and defamation complaints for a video from 2017 playing a radio spot of Angela Merkel. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:2,type:4,text:"A video comparing various gaming platforms was reported for hate speech. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:1,text:"We received an insult complaint for a rap music video showing a staged kidnapping of a prominent couple. We found that the content violates German law and we blocked it for Germany."},{Fa:2,type:1,text:"We received a hate speech complaint for a video documenting a political torchlight procession by a right-wing group. We didn\u2019t find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:2,type:1,text:"We received a defamation and insult complaint for a video that heavily criticized a journalist. We found that the content violates German law and we blocked it for Germany."},{Fa:2,type:1,text:"A video advertisement for a political party was reported for holocaust denial. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:2,text:"A video featuring a German TV documentary show about a biker gang was reported for hate speech. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:2,type:2,text:"We received a hate speech complaint for a video showing a person that discusses arguments for and against abortion. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:3,text:"A comment about a German World War 2 commander was reported for hate speech. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:3,text:"We received a hate speech complaint for a video discussing religious groups and theological theories. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:2,type:3,text:"We received a complaint for hate speech and display of illegal symbols for an artistic music video criticizing a fictional Third Reich as totalitarian. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:2,type:4,text:"We received a defamation complaint about a comment allegedly insulting the complainant. We found that the comment violates German law, and we blocked it for Germany."},{Fa:2,type:4,text:"A comment about the complainant beneath a gaming video was reported for insult. We found that the content violates German law and YouTube\u2019s Community Guidelines and we removed it."},
{Fa:2,type:4,text:"We received several insult complaints about a video containing verbal attacks and insults towards religions and protected groups. We found that the content violates German law and YouTube\u2019s Community Guidelines and we removed it."},{Fa:3,type:4,text:"A rap video that included insults and death threats towards an identifiable German politician was reported for defamation and insult. We found that the content violates German law and we blocked it for Germany."},{Fa:3,type:0,
text:"We received a defamation complaint from a German politician against a video featuring TV clips that discuss recent controversies that the politician was involved with. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:3,type:4,text:"We received a complaint against a video that referred to sea rescuers (Seenotretter) as smugglers (\u201cSchlepper\u201d). We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:3,type:3,text:"We received numerous removal requests for videos following the machete attack in Stuttgart. We removed the majority of the videos for violating YouTube\u2019s Community Guidelines on graphic violence, while newsworthy and documentary footage was age-restricted."},
{Fa:3,type:2,text:"We received a removal request for a video depicting police body cam footage. In the video, an identifiable individual is shot by police and receives emergency medical attention. We found that the content violates German law and we blocked it for Germany."},{Fa:4,type:2,text:"We received a removal request from a University for a video depicting a student who appeared to be threatening to commit an \u201cAmoklauf\u201d. We found that the content violates German law and we blocked it for Germany."},
{Fa:4,type:2,text:"We received a removal request for a video that contained an interview with an individual in Arabic. The complaint claimed that the video was promoting an organisation that is proscribed in Germany. We found that the content violates German law and we blocked it for Germany."},{Fa:4,type:4,text:"We received a removal request for a comment that aimed to insult identifiable members of the Green Party by attacking their physical characteristics. We found that the content violates German law and we blocked it for Germany."},
{Fa:4,type:4,text:"We received a removal request for various videos from a law firm who claimed that the content defamed their client. The videos discussed conspiracy theories and cults that the claimant was alleged to be involved with. We found that some URLs violate German law and we blocked it for Germany. For the rest, we were either missing information or found them lawful."},{Fa:4,type:0,text:"We received a removal request for 3 videos from a political activist who speaks openly against the religion of Islam. The videos depicted discussions about the Quran and 2 of the URLs depicted anti-social behaviour being enacted on the activist by members of the public. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:4,type:3,text:"We received a removal request for a video that depicted an unconstitutional symbol. The video featured educational and historical content. The uploader\u2019s engagement with the symbol suggests an understanding of its status and provided a historical narrative and place for discussion. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:4,type:0,text:"We received a removal request for a video showing political extremists breaking into and destroying the contents of a known far right affiliated store. The footage did not contain a direct incitement to crime. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:4,type:2,text:'We received a removal request for a video featuring Nazi symbolism which had a description claiming that video was solely intended for comedic purposes and that is uploader is "not a Nazi". We found that the content violates German law and we blocked it for Germany.'},{Fa:4,type:4,text:"We received a removal request for a video featuring a policeman who is repeatedly insulted. We found that the content violates German law and we blocked it for Germany."},{Fa:5,type:2,text:"We received complaints for a video that discusses the riots that occurred in Stuttgart following a police investigation of an alleged drugs incident. The video discusses the incident in an exaggerated and satirical way. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:5,type:0,text:"We received a complaint for a video uploaded by a controversial group with the aim of raising funds for a prominent political party. The video is a song related to the topic of migration into Germany. In order to evaluate the request, we requested additional information from the complainant, but did not receive a response. Therefore, we did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:5,type:3,text:"We received a complaint for a video containing journalistic content related to the murder case of the District President of Kassel. The video is a news documentary on the murder case and shows excerpts from a police interview with the alleged murderer. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:5,type:2,text:'We received a complaint for a video that depicted the establishment of a vigilante group to protect against \u201ccriminal migrants\u201d in Nuremberg. The activists proclaimed a protection zone in a part of N\u00fcrnberg and gave out CS gas cans to German women to protect themselves from, what they term, "imported sex offenders". While reviewing the content for violations of German law, we found that the video had already been removed for violating YouTube\u2019s Community Guidelines.'},
{Fa:5,type:0,text:"We received a complaint for a video from a German Youtuber who advocates for people in Berlin to proceed with a demonstration, despite the fact that it had been prohibited by the Berlin police. Since the Berlin Administrative Court lifted the prohibition order of the Berlin police, we did not find a violation of YouTube\u2019s Community Guidelines or German law or German law."},{Fa:5,type:1,text:"We received a complaint for a video in which Antifa called for action to be taken against Nazis (including violent action) and listed a number of ways in which action could be taken. In light of the NetzDG self-regulation process, we forwarded this case to the FSM for review who found that the content violates German law. We therefore blocked the video in Germany."},
{Fa:5,type:2,text:"We received complaints for a video that featured a trailer for an alleged parody-game created by a controversial organisation. The trailer targeted certain protected groups, as well as specific public figures. We found that the content violated YouTube\u2019s Community Guidelines. The associated channel was also removed for violating YouTube\u2019s Community Guidelines."},{Fa:5,type:1,text:"We received a complaint for a video documenting a political demonstration and interactions between protestors and the police. In the video, an identifiable individual is unconscious on the ground. He is surrounded by police and one police officer is attending him. In light of the NetzDG self-regulation process, we forwarded this case to the FSM for review who did not find a violation of German law."},
{Fa:6,type:4,text:"We received a removal request against a video claiming a high ranked politician is against prohibiting pedophilia and for legalising having sex with children. We found that the content violates German law and we blocked it for Germany."},{Fa:6,type:4,text:"We received a removal request against a comment claiming that the police are Nazis. We found that the content violates German law and blocked it for Germany."},{Fa:6,type:4,text:"We received a removal request against a comment insulting a deceased politician and claiming he got what he deserved. We found that the content violates German law and blocked it."},
{Fa:6,type:2,text:"We received a removal request against a video showing a short clip from a brutal scene of a movie without any context and with clear intent to shock. We found that the content violates German law and we blocked it for Germany."},{Fa:6,type:0,text:"We received a removal request against a short video by a comedian telling his opinion and criticising members of the AfD. Because of the comeditic intent and public interest, we did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:6,type:0,text:"We received a removal request against a video comparing corona - protestors to Nazis in a satirical and comedic way. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:6,type:1,text:"We received a removal request for two videos showing an US citizen getting shot by the police in a hotel. The footage was inter alia uploaded by a US news source. Upon sending the removal request to our outside counsel, we found that the videos violate German law and we blocked them for Germany."},
{Fa:6,type:2,text:"We received a removal request against a short video where it is claimed that Germany is harmed by foreigners, and that Germans should stand up for themselves and eliminate the immigrants. We found that the content violates German law and we blocked it for Germany."},{Fa:7,type:0,text:"We received a removal request for a video showing an agent film from the 1930ies that was produced as nazi propaganda. Nowadays, the film holds an FSK (self regulation for movies) release. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:7,type:0,text:"We received a removal request for a music video showing a German marching song often performed during the nazi times but also later on. We did find a violation of YouTube\u2019s Community Guidelines and removed the video globally. We did not find a violation of German law."},{Fa:7,type:0,text:"We received a removal request for a video explaining how to cheat on a drug test. We did not find a violation of German law, however, we globally removed the video due to a Community Guidelines violation."},
{Fa:7,type:4,text:"We received a removal request for a German news-like video falsely claiming that a celebrity has died. We found that the content violated German law and blocked it for Germany."},{Fa:7,type:4,text:"We received a removal request for a video harshly insulting employees of a certain bank. We found that the content violated German law and blocked it for Germany."},{Fa:7,type:4,text:"We received a removal request for a comment that claimed the German government ordered a murder of a member of a smaller political party. On the basis of a press release of the leading public prosecutor's office the actual facts of the case could be established. We found that the content violated German law and removed it."},
{Fa:7,type:1,text:'We received a removal request for a comment claiming that the CDU (political party) tortured and killed 50,000 people in Germany. The comment refers to a video showing an election campaign from 1957. We have sent the case within the self-regulation to the FSM (self regulation for multimedia) who found the content is legal. The decision by the FSM can be reviewed <a href="https://www.fsm.de/sites/default/files/netzdg0552021_voe.pdf" target="_blank">here</a>.'},{Fa:7,type:3,text:"We have received a removal request for a video that was filmed from the bodycam of a police officer who shot a man. The video was uploaded by a US news site. The rifle of the deceased later turned out to be an air gun. The footage was released by law enforcement after the officer was declared innocent. We did not find a violation of YouTube\u2019s Community Guidelines nor sec. 1 para 3 NetzDG. However, we locally blocked the video due to a violation of other local law."},
{Fa:8,type:0,text:"We have received a complaint for a video which shows someone entering a soccer stadium without first obtaining a ticket. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:8,type:0,text:"We received a complaint for a video which shows security footage of teenagers breaking into an arbour/club house. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},{Fa:8,type:0,text:"We received a complaint for a video in which a person talks about the vandalism of a distribution box reported in the news. We did not find a violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:8,type:4,text:"We have received a first-party complaint for a comment left under a video with the sole intention to insult. We found that the content violates German law and we blocked it for Germany."},{Fa:8,type:5,text:"We received a complaint for a comment left under a video documentary discussing the use of symbols in support of the war against Ukraine. We found that the content violates German law and we blocked it for Germany."},{Fa:8,type:6,text:"We have received a complaint for a video that shows reports about a fire in a kindergarten. Based on finding barbeque utensils and empty vodka bottles, it is alleged, on embedded subtitles, that Ukrainian building workers caused the fire. We found that the content violates German law and we blocked it for Germany."},
{Fa:8,type:7,text:"We have received a complaint for a video that shows content from a news broadcast, recorded with a smartphone, showing a news anchor announcing a news segment. The anchor then appears to suffer a medical emergency. The loss of consciousness is played on a loop with music in the background. We found that the content violates German law and we blocked it for Germany."},{Fa:8,type:4,text:"We have received a complaint for a video uploaded in Germany making false claims about the baby of a celebrity. The video title falsely claimed that the child was born with disabilities, possible to draw attention and clicks. We found that the content violated German law and we blocked it in Germany."},
{Fa:9,type:7,text:"We received a complaint for a video that showed an identifiable helpless person on display. We found that the content violates German law and we blocked it for Germany."},{Fa:9,type:0,text:'We received a complaint for a video showing a satirical news report. We submitted the case to the Freiwillige Selbstkontrolle Multimedia-Diensteanbieter e.V. (FSM) under the regulated self-regulation mechanism of NetzDG. The FSM did not find a violation of NetzDG (<a href="https://www.fsm.de/files/2022/11/netzdg0812022_voe.pdf">see here</a>). We also did not find a violation of YouTube\u2019s Community Guidelines.'},
{Fa:9,type:5,text:"We received a complaint for a video with a flag from the Kurdistan Workers' Party (PKK), which is generally illegal to display in Germany. We found that the content violates German law and we blocked it for Germany. We did not find a violation of YouTube\u2019s Community Guidelines."},{Fa:9,type:4,text:'We received a complaint for a video showing a public figure holding a speech calling a German politician insane. The audio of the speech appeared to be a voice over. We submitted the case to the Freiwillige Selbstkontrolle Multimedia-Diensteanbieter e.V. (FSM) under the regulated self-regulation mechanism of NetzDG. The FSM did not find a violation of NetzDG (<a href="https://www.fsm.de/files/2022/11/netzdg0892022_voe.pdf">see here</a>). We also did not find a violation of YouTube\u2019s Community Guidelines.'},
{Fa:9,type:0,text:"We received a complaint for a video that showed a tool for performing a hacking attack in a video game and offered hacking services. We did not find a violation of German law, however, we globally removed the video due to a Community Guidelines violation."},{Fa:9,type:0,text:"We received a complaint for a video that showed an identifiable helpless person on display. We found that the content violates German law and we blocked it for Germany."},{Fa:10,type:4,text:"We received a complaint for a comment on a video. The comment was part of a historical and political discussion with another user in the comment section. We found no violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:10,type:10,text:"We received a complaint for allegedly inappropriate images of sexual nature in a video. Upon review, we found no violation of YouTube\u2019s Community Guidelines or German law."},{Fa:10,type:7,text:"We received a complaint for a video showing a nurse attacking an elderly woman in a nursing home. We submitted the case to the Freiwillige Selbstkontrolle Multimedia-Diensteanbieter e.V. (FSM) under the regulated self-regulation mechanism of NetzDG. The FSM did not find a violation of NetzDG. We also did not find a violation of YouTube\u2019s Community Guidelines."},
{Fa:10,type:8,text:"We received a complaint for a video featuring a song glorifying violence against children. We submitted the case to the Freiwillige Selbstkontrolle Multimedia-Diensteanbieter e.V. (FSM) under the regulated self-regulation mechanism of NetzDG. The FSM found the content to be a violation of NetzDG and we blocked it for Germany. We also globally removed the video due to a Community Guidelines violation."},{Fa:10,type:8,text:"We received a complaint for a video that allegedly spreads hate and insults against climate activists. We found no violation of YouTube\u2019s Community Guidelines or German law."},
{Fa:10,type:7,text:"We received a complaint for a live stream video where a man was shown partially naked for a few seconds as his child was streaming. We blocked the video for Germany. We did not find a violation of YouTube\u2019s Community Guidelines."},{Fa:10,type:4,text:"We received a complaint for a video containing strongly worded statements against the German chancellor Olaf Scholz and others. We submitted the case to the Freiwillige Selbstkontrolle Multimedia-Diensteanbieter e.V. (FSM) under the regulated self-regulation mechanism of NetzDG. The FSM did not find a violation of NetzDG. We also did not find a violation of YouTube\u2019s Community Guidelines."},
{Fa:10,type:9,text:'We received a complaint for a video that includes an audio recording describing a police raid targeting a right wing organization. The video also shows a person in a bear costume with a shirt stating "Abschieb\u00e4r". We found that the content violates German law and we blocked it for Germany. We did not find a violation of YouTube\u2019s Community Guidelines.'},{Fa:10,type:8,text:"We received a complaint for a video that shows a man talking about different spices he uses. The container of one spice is showing a swastika symbol on the lid. In this context it did not appear to be Nazi symbol but a very similar looking sign used in India. We could not find any reason why the reported video should be restricted according to NetzDG. We also did not find a violation of YouTube\u2019s Community Guidelines."},
{Fa:10,type:8,text:"We received a complaint for a video that included the audio of a hymn common during the Second World War. We found that the content violates German law and we blocked it for Germany. We did not find a violation of YouTube\u2019s Community Guidelines."}];var Ybb=["Period","Type",""],Zbb=new Map([[0,"Legally inactionable"],[1,"Outside counsel"],[2,"Explaining context"],[3,"EDSA preservation"],[4,"Defamation/insult"],[8,"Hate Speech or Political Extremism"],[5,"Rewarding/Approving of Offenses"],[6,"Incitement to Hatred"],[7,"Privacy"],[10,"Sexual Content"],[9,"Terrorist or Unconstitutional Content"]]),$bb=function(){return _.EA(_.FA(),_.LA(_.GA(_.GA(_.HA(),_.JA().pb("period").setOptions([new _.KA("All periods",""),...Cza().map(a=>new _.KA(Xbb.get(a),
