ma:1});var tsa=[{wc:"2006-01-20",heading:"Google makes headlines for refusing a government request.",content:fB("Asserting that the request is \u201cunnecessary, overly broad, would be onerous to comply with, would jeopardize its trade secrets, and could expose identifying information about its users,\u201d Google resists a Justice Department request to turn over records on millions of users\u2019 search queries. The request, enabled by the USA Patriot Act, is ostensibly part of the government\u2019s effort to uphold an online pornography law."),
rf:"READ NEWS STORY",bf:"https://www.nytimes.com/2006/01/20/technology/20google.html"},{wc:"2009-12-21",heading:"Google publishes a blog post defining the meaning of openness.",content:fB("In defining open systems, open technology, and open information, Google lays the ideological groundwork for the Transparency Report. A paragraph about transparency discusses tools and other mechanisms for sharing information with users, asking, \u201cHow can you increase users\u2019 engagement with your product through increasing transparency?\u201d"),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2009/12/meaning-of-open.html"},{wc:"2010-04-20",heading:"Google launches the Government Requests tool.",content:fB('Quoting the <a href="https://www.un.org/en/universal-declaration-human-rights/index.html">Universal Declaration on Human Rights</a>\u2019 statement that \u201ceveryone has the right to freedom of opinion and expression,\u201d Google launches a Government Requests tool to inform people about government requests for user data or content removal. In the announcement, David Drummond wrote that \u201cwe hope this tool will shine some light on the scale and scope of government requests for censorship and data around the globe.\u201d'),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2010/04/greater-transparency-around-government.html"},{wc:"2010-09-21",heading:"Google launches the Transparency Report.",content:fB("A few months after launching the Government Requests tool, Google added data about product traffic disruptions and combined the tools to create the first Transparency Report. The new interactive tool was intended to show users how policy impacts access to information and inform discussions about the free flow of information online."),
rf:"READ BLOG POST",bf:"https://googlepublicpolicy.blogspot.com/2010/09/tools-to-visualize-access-to.html"},{wc:"2011-06-27",heading:"An update to the Transparency Report adds important details about government requests.",content:fB("In this batch of updates, Google makes it easier for users to spot trends in the data by adding filtering on a country-by-country basis. The reports also begin disclosing the reasons that Google has been asked to remove content, such as an allegation of defamation or hate speech. And for the first time, Google begins revealing the percentage of user data requests they\u2019ve complied with in whole or in part."),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2011/06/updated-and-more-detailed-transparency.html"},{wc:"2011-09-27",heading:"Google releases the raw data behind the Transparency Report.",content:fB("The data is made available for export in various machine-readable formats. Developers and researchers are able to take the data and re-visualize it in different ways, or combine it with information from other organizations in order to create and test new hypotheses."),rf:"SEE THE DATA",bf:"user-data"},
{wc:"2012-05-24",heading:"Google adds the copyright removal requests section to the Transparency Report.",content:fB('Five months after Internet-driven political action leads to the <a href="https://googleblog.blogspot.com/2012/01/dont-censor-web.html">suspension of PIPA and SOPA</a> bills in the US, a new addition to the Report discloses the number of requests that Google receives from copyright owners to remove Google Search results allegedly linking to infringing content.')},{wc:"2012-07-02",heading:"Other companies begin to release transparency reports.",
content:fB('In July 2012, <a href="https://transparency.twitter.com/">Twitter</a> begins to disclose information about how government requests affect freedom of information on the internet. Over the next year, <a href="https://www.microsoft.com/about/csr/transparencyhub/">Microsoft</a>, <a href="https://www.apple.com/privacy/transparency-reports/">Apple</a>, and <a href="https://govtrequests.facebook.com/about/">Facebook</a> follow, establishing transparency reporting as an industry-wide practice.')},
{wc:"2013-03-05",heading:"Google begins including data about National Security Letters (NSLs) in the Transparency Report.",content:fB('With additions to the <a href="/user-data/us-national-security">page on user data requests in the US</a>, Google adds information, in broad strokes, on how many NSLs for user data Google receives, as well as the number of accounts in question.'),rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2013/03/transparency-report-shedding-more-light.html"}],usa=[{wc:"2013-06-06",
heading:"Leaks reveal that the National Security Agency is collecting the telephone records of millions of US customers.",content:fB("The first leak resulting from the Edward Snowden disclosures reveals that Verizon has been required to give the NSA information on all telephone calls in its systems on an ongoing, daily basis. Continued revelations about international government surveillance will shock the world and reinforce the importance of transparency online."),rf:"READ NEWS STORY",bf:"https://www.theguardian.com/world/2013/jun/06/nsa-phone-records-verizon-court-order"},
{wc:"2013-06-07",heading:"Google responds to allegations about PRISM.",content:fB("Larry Page, CEO and David Drummond, Chief Legal Officer, affirm that \u201cwe have not joined any program that would give the U.S. government\u2014or any other government\u2014direct access to our servers.\u201d In a post to the Google blog, they note that the PRISM episode confirms the need for a more transparent approach and the importance of Google\u2019s own Transparency Report."),rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2013/06/what.html"},
{wc:"2013-06-11",heading:"Google looks to increase transparency around national security requests.",content:fB('Seeking permission to publish more national security request data, Google sends a request to the offices of the Attorney General and the Federal Bureau of Investigation signed by Google\u2019s Chief Legal Officer David Drummond. In the letter, Google specifically requests the ability to disclose information about <a href="https://en.wikipedia.org/wiki/Foreign_Intelligence_Surveillance_Act">FISA requests</a> to users.'),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2013/06/asking-us-government-to-allow-google-to.html"},{wc:"2013-06-25",heading:"Google publishes malware and phishing data in a new Safe Browsing section.",content:fB("In 2006, Google launched Safe Browsing, a service that identifies unsafe websites across the Internet and notifies users and website owners of potential harm. In June of 2013, Google begins making Safe Browsing data available, including statistics on the prevalence of unsafe websites detected and notifications provided to users. Google later adds a search tool that enables users to check the Safe Browsing status of a URL."),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2013/06/transparency-report-making-web-safer.html"},{wc:"2014-03-20",heading:"Google begins using only encrypted HTTPS connections for checking and sending email.",content:fB('Google has <a href="https://gmail.googleblog.com/2008/07/making-security-easier.html">supported HTTPS</a> since it launched, and in 2010 it <a href="https://gmail.googleblog.com/2010/01/default-https-access-for-gmail.html">made HTTPS the default</a>. The new change means that no one can listen in on messages as they go back and forth between users and Gmail\u2019s servers.'),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2014/03/staying-at-forefront-of-email-security.html"},{wc:"2014-05-13",heading:"The Court of Justice of the European Union hands down a landmark privacy ruling.",content:fB('In its <a href="https://curia.europa.eu/jcms/upload/docs/application/pdf/2014-05/cp140070en.pdf">decision</a>, Europe\u2019s high court finds that people have the right to ask for information to be removed from search results that include their names if it is \u201cinadequate, irrelevant or no longer relevant, or excessive.\u201d For Google, this \u201c<a href="https://googlepolicyeurope.blogspot.com/2015/07/implementing-european-not-global-right.html">right to delist</a>\u201d means that Europeans may ask search engines to delist certain links from results for when a user searches for that individual\u2019s name. A few months later, Google <a href="/eu-privacy/overview">adds a section</a> to the Transparency Report that provides information on the impact of this ruling.'),
rf:"READ BLOG POST",bf:"https://europe.googleblog.com/2015/07/implementing-european-not-global-right.html"},{wc:"2014-06-03",heading:'Google adds the <a href="/safer-email/overview">Safer Email</a> section of the Transparency Report.',content:fB('The new section is intended to help users understand whether their emails are protected by encryption. At the same time, Google releases the source code for the Chrome extension <a href="https://security.googleblog.com/2014/06/making-end-to-end-encryption-easier-to.html">End-to-End</a> for the open source community to test, evaluate, and improve.'),
rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2014/06/transparency-report-protecting-emails.html"},{wc:"2014-09-15",heading:"In the tenth update to the Transparency Report, Google notes that government demands for user information have risen 150% over the last five years.",content:fB('In this update, Google adds details about the number of government demands for user information in criminal investigations. The update also covers demands for user information under the <a href="https://support.google.com/transparencyreport/answer/7380434?ref_topic=7380433/#FISA">Foreign Intelligence Surveillance Act</a> (FISA) and via <a href="https://support.google.com/transparencyreport/answer/7380434?ref_topic=7380433/#NSL">National Security Letters</a> (NSLs).'),
rf:"READ BLOG POST",bf:"https://publicpolicy.googleblog.com/2014/09/transparency-report-government-demands_15.html"},{wc:"2015-06-01",heading:"Google launches privacy.google.com.",content:fB("To address users\u2019 questions about how Google is using their information, Google creates privacy.google.com to shed more light on what data Google collects, how the company uses the data, how users can keep their information safe, and more."),rf:"READ BLOG POST",bf:"https://googleblog.blogspot.com/2015/06/privacy-security-tools-improvements.html"},
{wc:"2016-03-14",heading:"Google adds HTTPS section to the Transparency Report.",content:fB("Reinforcing its commitment to security, Google adds a new HTTPS section to the Transparency Report that provides data on HTTPS connectivity across Google and at sites across the web. The information quickly becomes a tool that Internet security advocates use to help encourage broader adoption of HTTPS."),rf:"READ BLOG POST",bf:"https://security.googleblog.com/2016/03/securing-web-together_15.html"}],vsa=[{wc:"2017-07-18",
heading:"The Transparency Report undergoes a full overhaul.",content:fB("For two years, teams at Google worked to transform the disparate sections of the Transparency Report into a single platform with a unified look and feel across all sections. In addition, the teams sought for ways to provide more data and more context around that data. This new version of the Transparency Report honors the work done by Googlers dedicated to the mission of transparency over the last 7 years and sets the stage for a future where that mission will evolve.")},
{wc:"2018-02-26",heading:"Expanding transparency around the \u201cright to be forgotten\u201d",content:fB('On February 26, 2018, we expanded the \u201cEuropean privacy removals from Search\u2014a.k.a \u201cthe right to be forgotten\u201d\u2014report to include data about the types of content and the types of websites that individuals ask us to delist from Search results. The additional data dates back to January 2016, when our reviewers began to manually annotate each URL included in a request so that we could track and evaluate the scope of removal requests. The launch coincided with the public release of an internally produced research paper, \u201c<a href="https://g.co/research/rtbf_report">Three Years of the Right to be Forgotten</a>,\u201d which based its analysis on the same dataset. Our goal was to inform the ongoing discussion about the interplay between the right to privacy and the right to access lawful information online.'),
rf:"READ BLOG POST",bf:"https://www.blog.google/topics/google-europe/updating-our-right-be-forgotten-transparency-report/"},{wc:"2018-04-23",heading:"Enforcing YouTube\u2019s Community Guidelines",content:fB("On April 23, 2018, we published our first quarterly YouTube Community Guidelines enforcement report, providing data for Q4 of 2017. This report publicly shares aggregate data on our efforts to remove content that violates YouTube\u2019s Community Guidelines and provides insight into how we use a combination of machines and human flaggers to enforce our policies at scale."),
rf:"READ BLOG POST",bf:"https://youtube.googleblog.com/2018/04/more-information-faster-removals-more.html"},{wc:"2018-07-26",heading:"A new legal requirement",content:fB('Germany\u2019s Network Enforcement Act ("Netzdurchsetzunggesetz", or NetzDG) came into effect on October 1, 2017. This law set requirements for removal of illegal content and turnaround times on those removals for social networks with more than 2 million registered users in Germany. The law references 22 statutes in defining what constitutes illegal content, and requires each services covered by NetzDG to provide reports every 6 months on removals under the law. On July 26, 2018, we published our first NetzDG report.'),
rf:"READ BLOG POST IN GERMAN",bf:"https://germany.googleblog.com/2018/07/update-netzdg.html"},{wc:"2018-08-15",heading:"Supporting election integrity through greater advertising transparency",content:fB('At a series of US Congressional hearings in late 2016, Google pledged to <a href="https://storage.googleapis.com/gweb-uniblog-publish-prod/documents/google_US2016election_work_going_forward_1_WPKcAUQ.pdf">fulfill four commitments</a> to relating to transparency and accountability for election advertising. On August 15, 2018, we completed the final two of those four commitments with the launch of our first ever election advertising transparency report, "Political advertising on Google," and the accompanying creative library.')}],
wsa=[{wc:"2021-02-24",heading:"Google\u2019s efforts to combat online CSAM",content:"As part of our commitment to keeping platforms safe, we launched the\n    Combating Online Child Sexual Abuse Material transparency report. This\n    report contains data regarding Google\u2019s efforts and resources to combat\n    CSAM on our platforms and the work we do to detect, remove, and report\n    this abusive material.",rf:"Read More",bf:"https://transparencyreport.google.com/child-sexual-abuse-material/"},
{wc:"2021-04-08",heading:"Deeper insights into government requests",content:'We published the data and samples of noteworthy government requests to\n    remove content we received from July to December 2020 on our "Government\n    requests to remove content" report. This information shines a light on\n    the scale and scope of government requests for online content removal\n    and its impact through the second half of 2020.',rf:"Read More",bf:"https://transparencyreport.google.com/government-removals/overview/"},
